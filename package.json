{
  "name": "nx-aws",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Bojan Bratuz",
  "keywords": [
    "AWS",
    "S3",
    "Tasks",
    "Runner",
    "Cache",
    "Workspace",
    "Nrwl",
    "Nx",
    "Monorepo"
  ],
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bojanbass/nx-aws"
  },
  "scripts": {
    "nx": "nx",
    "build": "nx build",
    "test": "nx test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected": "nx affected",
    "nx:migrate": "nx migrate latest",
    "nx:migrate:run-migrations": "nx migrate --run-migrations --createCommits"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nx/devkit": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@smithy/util-stream": "4.8.2",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "aws-sdk-client-mock": "4.1.0",
    "nx": "23.2.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "baseline-browser-mapping": "2.11.25",
    "browserslist": "4.28.9",
    "fflate": "0.8.3",
    "smol-toml": "1.7.2"
  }
}
