{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "importHelpers": false,
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@nx-aws-plugin/nx-aws-cache": ["./packages/nx-aws-cache/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
